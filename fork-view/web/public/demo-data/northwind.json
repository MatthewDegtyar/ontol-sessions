  "POST /exports/sftp/schedule": {
   "key": "POST /exports/sftp/schedule",
   "name": "Nightly export to SFTP",
   "status": "added",
   "group": "exports",
   "summary": "Yesterday's shipments arrive on the client's SFTP server every night, with no one clicking anything.",
   "changed": null,
   "also": [
    "Globex"
   ],
   "work": {
    "ticket": "HAR-101",
    "owner": "sam",
    "asked": "Northwind needs yesterday's shipments delivered as a CSV to their SFTP server every night.",
    "why": "A plain cron job sent the file twice after a restart, which would have double-counted shipments in billing. It moved to the job queue with an idempotency key.",
    "quote": "Keep the column mapping in clients/northwind for now. We'd need a second client to know what's generic.",
    "files": [
     "clients/northwind/mapping.py",
     "clients/northwind/sftp.py"
    ]
   },
   "siblings": [
    {
     "fork": "globex",
     "client": "Globex",
     "key": "POST /exports/s3/schedule",
     "name": "Nightly export to S3",
     "ticket": "HAR-117"
    }
   ],
   "edge": {
    "from": "GET /exports/csv",
    "via": "Both call db.shipments.on",
    "kind": "added"
   },
   "files": [
    {
     "path": "routes/exports_sftp.py",
     "status": "added",
     "additions": 6,
     "deletions": 0,
     "diff": [
      "@@ -0,0 +1,6 @@",
      "+@router.post(\"/exports/sftp/schedule\")",
      "+def schedule_sftp_export(body: SftpSchedule):",
      "+    # The idempotency key stops a retry from sending a second file.",
      "+    key = f\"{body.client}:{body.day}\"",
      "+    rows = db.shipments.on(body.day)",
      "+    return queue.enqueue(send_sftp, rows, body, idempotency_key=key)"
     ]
    },
    {
     "path": "clients/northwind/mapping.py",
     "status": "added",
     "additions": 7,
     "deletions": 0,
     "diff": [
      "@@ -0,0 +1,7 @@",
      "+# Northwind's column names. Kept out of core until a second client shows what's generic.",
      "+COLUMNS = {",
      "+    \"reference\": \"NW_REF\",",
      "+    \"shipped_at\": \"DESPATCH_DT\",",
      "+    \"carrier\": \"HAULIER\",",
      "+    \"weight_kg\": \"GROSS_KG\",",
      "+}"
     ]
    },
    {
     "path": "clients/northwind/sftp.py",
     "status": "added",
     "additions": 4,
     "deletions": 0,
     "diff": [
      "@@ -0,0 +1,4 @@",
      "+def send_sftp(rows, schedule):",
      "+    body = to_csv(rows, columns=COLUMNS)",
      "+    with sftp_connect(schedule.host, schedule.credential_ref) as conn:",
      "+        conn.put(f\"shipments-{schedule.day}.csv\", body)"
     ]
    }
   ],
   "advice": {
    "kind": "merge",
    "text": "Built twice. Globex has its own version, so this is a candidate for main."
   }
  },
