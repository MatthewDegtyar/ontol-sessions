   "work": {
    "ticket": "HAR-109",
    "owner": "jo",
    "asked": "Keep audit logs for 7 years to meet Northwind's contract.",
    "why": "The retention setting was global, so raising it would have kept every client's logs for 7 years at about 6x the storage cost. It became a per-client override with a 1-year default.",
    "changed": "Retention is set per client instead of 1 year for everyone.",
    "files": [
     "core/settings.py",
     "migrations/015_retention_override.sql"
    ]
   },
   "siblings": [],
   "edge": {
    "from": "GET /audit",
    "via": "Same route, different code",
    "kind": "changed"
   },
   "files": [
    {
     "path": "routes/audit.py",
     "status": "modified",
     "additions": 4,
     "deletions": 3,
     "diff": [
      "@@ -1,6 +1,7 @@",
      "-RETENTION_DAYS = 365",
      "+def retention_days(client):",
      "+    return settings.retention_override(client) or 365",
      " ",
      " ",
      " @router.get(\"/audit\")",
      "-def audit_log(since: date):",
      "-    return db.audit.since(max(since, today() - days(RETENTION_DAYS)))",
      "+def audit_log(since: date, client: str):",
      "+    return db.audit.since(max(since, today() - days(retention_days(client))))"
     ]
    },
    {
     "path": "core/settings.py",
     "status": "modified",
