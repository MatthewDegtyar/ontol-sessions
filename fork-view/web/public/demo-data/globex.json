      "@@ -0,0 +1,4 @@",
      "+@router.post(\"/exports/s3/schedule\")",
      "+def schedule_s3_export(body: S3Schedule):",
      "+    rows = db.shipments.on(body.day)",
      "+    return scheduler.nightly(upload_s3, rows, body)"
     ]
    },
    {
     "path": "clients/globex/s3.py",
     "status": "added",
     "additions": 5,
     "deletions": 0,
     "diff": [
      "@@ -0,0 +1,5 @@",
      "+def upload_s3(rows, schedule):",
      "+    body = to_csv(rows)",
      "+    s3_client(schedule.role_arn).put_object(",
      "+        Bucket=schedule.bucket, Key=f\"shipments/{schedule.day}.csv\", Body=body",
      "+    )"
     ]
    }
   ],
